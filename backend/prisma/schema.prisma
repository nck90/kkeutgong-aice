generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  password        String
  name            String?
  role            String             @default("USER")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  
  examProfile     ExamProfile?
  plans           Plan[]
  sessions        Session[]
  auditEvents     AuditPolicyEvent[]
}

model ExamProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  level           String   // 'FUTURE', 'JUNIOR', 'BASIC', 'ASSOCIATE', 'PROFESSIONAL'
  examDate        DateTime
  targetType      String   // 'PASS_FIRST', 'HIGH_SCORE', 'PRACTICAL'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  plans           Plan[]
}

model Plan {
  id                   String      @id @default(uuid())
  userId               String
  examProfileId        String
  startDate            DateTime
  examDate             DateTime
  compressionFlag      Boolean     @default(false)
  readyIndexSnapshot   Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user                 User        @relation(fields: [userId], references: [id])
  examProfile          ExamProfile @relation(fields: [examProfileId], references: [id])
  tasks                PlanTask[]
}

model PlanTask {
  id          String   @id @default(uuid())
  planId      String
  taskDate    DateTime
  taskType    String   // 'DRILL', 'LAB', 'REVIEW', 'MOCK'
  title       String   @default("학습 태스크")
  refId       String?
  status      String   // 'TODO', 'DONE', 'SKIPPED'
  estMinutes  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Lab {
  id          String   @id @default(uuid())
  title       String
  goal        String?
  level       String
  engineType  String   // 'BLOCK', 'GUI', 'JUPYTER'
  status      String   // 'DRAFT', 'PUBLISHED'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    Session[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  labId        String
  level        String
  engineType   String
  policyId     String
  mode         String   // 'PRACTICE', 'PRACTICE_PLUS', 'MOCK'
  status       String   // 'CREATED', 'RUNNING', 'PAUSED', 'SUBMITTED', 'REVIEWED', 'CLOSED', 'FORCE_CLOSED', 'ABANDONED'
  startedAt    DateTime?
  endedAt      DateTime?
  finalScore   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id])
  lab          Lab      @relation(fields: [labId], references: [id])
  submissions  StepSubmission[]
}

model StepSubmission {
  id               String   @id @default(uuid())
  sessionId        String
  stepNo           Int
  attemptNo        Int
  result           String   // 'PASS', 'FAIL', 'PARTIAL'
  score            Int      @default(0)
  errorCodes       String   // JSON string of array
  runtimeMs        Int      @default(0)
  codeSnapshotRef  String?
  createdAt        DateTime @default(now())

  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, stepNo, attemptNo])
}

model AuditPolicyEvent {
  id          String   @id @default(uuid())
  userId      String
  sessionId   String?
  policyId    String?
  action      String
  verdict     String   // 'ALLOW', 'WARN', 'BLOCK'
  reasonCode  String?
  clientIp    String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}
